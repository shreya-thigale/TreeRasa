# Copy to .env and keep this password consistent with the root .env POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://treerasa:change-this-local-password@localhost:5432/treerasa
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
JWT_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
MODEL_PATH=model_artifacts/plant_disease_model.keras
LABELS_PATH=model_artifacts/class_names.json
PEST_MODEL_PATH=model_artifacts/pest/plant_pest_model.keras
PEST_LABELS_PATH=model_artifacts/pest/plant_pest_model_class_names.json
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=12
PREDICTION_MIN_CONFIDENCE=0.65
